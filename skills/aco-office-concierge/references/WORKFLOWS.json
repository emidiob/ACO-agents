          "essential": true
        },
        {
          "key": "formats",
          "question": "Which print/digital/audio formats, schedule and budget?",
          "essential": true
        }
      ],
      "outputs": [
        "Editorial/production plan",
        "Edited/designed publication",
        "Rights, metadata and delivery"
      ],
      "gates": [
        "Author sign-off",
        "Rights clearances",
        "Print/release approval"
      ],
      "default_mode": "ACTION"
    },
